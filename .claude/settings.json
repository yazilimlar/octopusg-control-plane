{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show-ref:*)",
      "Bash(git ls-remote:*)",
      "Bash(git fetch origin:*)",
      "Bash(git tag:*)",
      "Bash(git remote -v)",
      "Bash(git remote show origin:*)",
      "Bash(git remote get-url:*)",
      "Bash(git remote add origin https://github.com/yazilimlar/octopusg-control-plane.git)",
      "Bash(git push origin:*)",
      "Bash(gh auth status:*)",
      "Bash(gh repo create yazilimlar/octopusg-control-plane:*)",
      "Bash(gh repo view yazilimlar/octopusg-control-plane:*)",
      "Bash(gh api repos/yazilimlar/octopusg-control-plane:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(npm ci --ignore-scripts:*)",
      "Bash(npm run validate)",
      "Bash(npm run validate:spec)",
      "Bash(npm run spec:write)",
      "Bash(npm run build)",
      "Bash(npm test)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rename:*)",
      "Bash(git remote set-url:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh workflow run:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(npm publish:*)",
      "Bash(npx:*)",
      "Bash(vercel:*)",
      "Bash(supabase:*)",
      "Bash(tailscale:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(security:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/Library/Keychains/**)"
    ]
  }
}
