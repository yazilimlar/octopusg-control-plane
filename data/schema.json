{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agoraxai:control-plane:snapshot:1",
  "title": "AgoraXAI Control Plane snapshot v1",
  "type": "object",
  "required": ["schemaVersion", "classification", "asOf", "sources", "registry", "approvalCandidates", "observations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "classification": {"type":"object","required":["umbrella","kind","visibility","codename"],"additionalProperties":false,"properties":{"umbrella":{"const":"AGORAXAI_UMBRELLA"},"kind":{"const":"INTERNAL_PLATFORM"},"visibility":{"const":"private"},"codename":{"const":"Octopus"}}},
    "asOf": {"type":"string","format":"date"},
    "sources": {"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","required":["name","sha256"],"additionalProperties":false,"properties":{"name":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "registry": {"$comment":"Expected registry_version and project_row_count are pinned only in data/registry.lock.json and enforced by scripts/import-registry.mjs and tests/registry-lock.test.ts (OG-REG-002); projects.length must equal project_row_count.","type":"object","required":["registry_version","project_row_count","projects","production_state","architecture"],"properties":{"registry_version":{"type":"string","minLength":1},"project_row_count":{"type":"integer","minimum":1},"projects":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/registryProject"}},"production_state":{"type":"object"},"architecture":{"type":"object"}},"additionalProperties":true},
    "observations": {"$comment":"Local observation store (OG-DATA-002). In the tracked canonical snapshot this block is always empty and present:false: validated observations from work/observations/latest.json are written by scripts/import-registry.mjs to the git-ignored overlay work/observations/snapshot-observations.json (same shape), which only the local bundle reads. src/truth.ts rejects secret-shaped values before either is written.","type":"object","required":["present","source","collector","collectedAt","records","rejected"],"additionalProperties":false,"properties":{"present":{"type":"boolean"},"source":{"type":"string"},"collector":{"type":["string","null"]},"collectedAt":{"type":["string","null"],"format":"date-time"},"records":{"type":"array","items":{"$ref":"#/$defs/observation"}},"rejected":{"type":"array","items":{"type":"object","required":["index","reason"],"additionalProperties":false,"properties":{"index":{"type":"integer","minimum":0},"reason":{"type":"string"}}}}}},
    "approvalCandidates": {"type":"array","minItems":22,"maxItems":22,"items":{"type":"object","required":["id","title","evidence","source"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^[A-Z][0-9]+$"},"title":{"type":"string","minLength":1},"evidence":{"type":"string"},"source":{"type":"string"}}}}
  },
  "$defs": {
    "evidenceKind":{"$comment":"v0.1 display kinds; unchanged in meaning.","enum":["observed","inferred","unknown","blocked"]},
    "truthState":{"$comment":"OG-DATA-001 five-kind truth model plus the two first-class absence states.","enum":["declared","observed","derived","approved","executed","unknown","blocked"]},
    "registryProject":{"type":"object","required":["id","canonical_name","category","lifecycle","evidence_level"],"properties":{"id":{"type":"string","minLength":1},"canonical_name":{"type":"string","minLength":1},"category":{"enum":["AGORAXAI_UMBRELLA","AGORAXAI_PLATFORM","ARTEMIS_PLATFORM","PRODUCT","VENTURE","LAB","ARCHIVE","NOT_A_PROJECT"]},"lifecycle":{"type":"string"},"evidence_level":{"type":"string"}},"additionalProperties":true},
    "fact":{"type":"object","required":["value","kind","source"],"additionalProperties":false,"properties":{"value":{"type":"string"},"kind":{"$ref":"#/$defs/evidenceKind"},"source":{"type":"string"},"note":{"type":"string"}}},
    "observation":{"type":"object","required":["projectId","field","value","truth","source","observedAt","collectedAt","expiresAt","status"],"additionalProperties":false,"properties":{"projectId":{"type":"string"},"field":{"type":"string"},"value":{},"truth":{"$ref":"#/$defs/truthState"},"source":{"type":"object","required":["adapter","resource"],"additionalProperties":false,"properties":{"adapter":{"enum":["github","vercel","supabase","http-uptime","mac-status","local-git"]},"resource":{"type":"string"}}},"observedAt":{"type":["string","null"],"format":"date-time"},"collectedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":["string","null"],"format":"date-time"},"status":{"enum":["ok","unknown","blocked","error"]},"reason":{"type":"string"}}},
    "stage":{"enum":["PROPOSED","EVIDENCE","REVIEWED","OWNER_APPROVED","EXECUTING","VERIFIED","COMPLETED","ROLLED_BACK"]},
    "simulationEntry":{"type":"object","required":["id","title","stage","note","updatedAt","demo"],"additionalProperties":false,"properties":{"id":{"type":"string"},"title":{"type":"string"},"stage":{"$ref":"#/$defs/stage"},"note":{"type":"string"},"updatedAt":{"type":"string"},"demo":{"const":true}}}
  }
}
